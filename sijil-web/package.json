{
  "name": "@sijil/web",
  "version": "0.1.0",
  "private": true,
  "description": "Sijil web, front unique (ADR 0032) : documents (recherche, fiche, dépôt, versions) et catalogue des types (liste, éditeur, revue) ; parle à sijil-bff (contracts/sijil-bff.yaml)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "openapi-typescript ../contracts/sijil-bff.yaml -o src/api/schema.d.ts",
    "api:check": "openapi-typescript ../contracts/sijil-bff.yaml -o src/api/schema.d.ts --check",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "build": "vite build",
    "size": "node scripts/check-bundle-size.mjs",
    "ci": "npm run api:check && npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build && npm run size && npm run e2e",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@awb/ui": "file:../vendor/awb-ui-1.3.0-SNAPSHOT.tgz",
    "@fontsource-variable/open-sans": "5.3.0",
    "@hookform/resolvers": "7.0.3",
    "@reactour/tour": "3.8.0",
    "@sijil/ui-kit": "0.1.0",
    "@tanstack/react-query": "5.108.4",
    "lucide-react": "1.70.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-router": "8.5.1",
    "tailwind-merge": "3.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.1",
    "axe-core": "4.14.1",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "msw": "3.0.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
